# Puerto del servidor
PORT=3010

# Clave del panel de mozo (se genera sola si falta — ver consola al arrancar)
MOZO_KEY=

# Llaves VAPID para Web Push (se generan solas si faltan)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@restaurante.local

# HTTPS opcional: rutas a los archivos de certificado.
# NECESARIO para que el push funcione en el celular del mozo fuera de localhost.
# SSL_KEY=./certs/key.pem
# SSL_CERT=./certs/cert.pem

# Redes con inspección TLS (proxy/firewall corporativo): el envío de push a FCM
# falla con SELF_SIGNED_CERT_IN_CHAIN. Descomentar UNA de estas opciones:
# PUSH_TLS_INSECURE=true      -> no verifica el cert solo en requests de push
# EXTRA_CA_CERT=./ca.pem      -> confía además en la CA de tu proxy (más seguro)
# HTTPS_PROXY=http://ip:port  -> salida a internet vía proxy explícito
